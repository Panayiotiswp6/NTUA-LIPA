# Copy to .env (never commit .env). The key stays on the server; the browser never sees it.
OPENAI_API_KEY=

# AI is PAUSED by default to protect the team's capped allowance (10 €).
# While paused the key is ignored and OpenAI is never called. Enable only with the team's approval.
AI_ENABLED=false

# Optional tuning
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_REASONING_EFFORT=low
# Safety limits for a shared, capped API allowance
AI_TOKEN_BUDGET=1500000
AI_RATE_LIMIT_PER_MINUTE=60
